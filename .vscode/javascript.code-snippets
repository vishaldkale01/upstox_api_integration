      "    stopLoss: ${5:44910},",
      "    quantity: ${6:1},",
      "    status: 'OPEN',",
      "    async save() {",
      "        console.log('Mock trade updated:', this);",
      "        return this;",
      "    }",
      "};"
    ],
    "description": "Creates a mock trade object for testing trailing stop logic"
  }
}