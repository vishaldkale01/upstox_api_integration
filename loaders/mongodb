// Kept for compatibility; never log connection strings or driver errors.
const mongoose = require('mongoose');
require('dotenv').config();
async function mongoConnect() {
  try {
    await mongoose.connect(process.env.MONGO_DB, { serverSelectionTimeoutMS: 5000 });
    console.log('Connected to MongoDB');
  } catch (_) {
    throw new Error('MongoDB connection failed; check local configuration');
  }
}
module.exports = mongoConnect;
