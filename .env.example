# Local setup only. Copy to .env; never commit your real values.
APP_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
TRUST_PROXY=0
MONGO_DB=mongodb://127.0.0.1:27017/upstox_trading
REDIS_URL=redis://127.0.0.1:6379
PYTHON_BACKEND_URL=http://127.0.0.1:8000
# Generate two different secrets with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-session-secret
# Must match ENGINE_API_TOKEN in the Python repository's .env
ENGINE_API_TOKEN=replace-with-the-shared-engine-secret
UPSTOX_API_KEY=your_api_key
UPSTOX_API_SECRET=your_api_secret
UPSTOX_REDIRECT_URI=http://localhost:3000/callback
# Your actual Upstox account ID(s), comma-separated. Other accounts are denied.
ALLOWED_UPSTOX_USER_IDS=your_upstox_user_id
